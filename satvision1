            </div>
            <div class="card" style="background:rgba(255,255,255,.03);">
              <h4>Profesionalan utisak</h4>
              <p>Uredno kabliranje i rek orman ostavljaju dobar utisak na klijente i tim.</p>
            </div>
          </div>

          <div style="margin-top:12px;">
            <a class="btn btn-success" href="tel:+381XXXXXXXXX">Pozovite za procenu</a>
            <a class="btn" href="#kontakt">Pošaljite nacrt</a>
          </div>
        </div>
      </div>
    </section>

