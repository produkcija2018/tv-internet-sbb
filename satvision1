              <label for="firma">Firma / Ime</label>
              <input id="firma" name="firma" placeholder="Npr. ABC d.o.o." required />
            </div>
            <div class="field">
              <label for="telefon">Telefon</label>
              <input id="telefon" name="telefon" placeholder="+381..." required />
