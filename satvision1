<!doctype html>
<html lang="sr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Strukturno kabliranje (SKS) za firme | Projektovanje + instalacija + testiranje</title>
  <meta name="description" content="Kompletno strukturno kabliranje (SKS) za firme: projektovanje, ugradnja, testiranje/sertifikacija i dokumentacija. Uredno, brzo i bez improvizacije. Pozovite SATVISION." />
  <meta name="theme-color" content="#0B1220" />

  <style>
    :root{
      --bg:#0B1220;
      --panel:#0F1A33;
      --card:#101C3A;
      --text:#EAF0FF;
      --muted:#B7C2E6;
      --line:rgba(255,255,255,.10);
      --brand:#4F8CFF;
      --brand2:#34D399;
      --danger:#FB7185;
      --shadow: 0 14px 40px rgba(0,0,0,.35);
      --radius: 18px;
      --radius2: 26px;
      --max: 1120px;
      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:var(--font);
      color:var(--text);
      background: radial-gradient(1200px 500px at 15% -10%, rgba(79,140,255,.30), transparent 60%),
                  radial-gradient(900px 500px at 90% 0%, rgba(52,211,153,.22), transparent 55%),
                  var(--bg);
      line-height:1.45;
    }
    a{color:inherit}
    .wrap{max-width:var(--max); margin:0 auto; padding:0 18px;}
    .topbar{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(12px);
      background: rgba(11,18,32,.70);
      border-bottom:1px solid var(--line);
    }
    .topbar-inner{
      display:flex; align-items:center; justify-content:space-between;
      padding:12px 0;
      gap:10px;
    }
    .brand{
      display:flex; align-items:center; gap:10px; text-decoration:none;
      font-weight:800; letter-spacing:.2px;
    }
    .logo{
      width:36px; height:36px; border-radius:10px;
      background: linear-gradient(135deg, var(--brand), var(--brand2));
      box-shadow: 0 10px 25px rgba(79,140,255,.25);
    }
    .nav{
      display:flex; gap:14px; align-items:center; flex-wrap:wrap;
      color:var(--muted);
      font-size:14px;
    }
    .nav a{ text-decoration:none; padding:8px 10px; border-radius:12px;}
    .nav a:hover{ background: rgba(255,255,255,.06); color: var(--text); }
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      gap:10px; padding:12px 14px; border-radius:14px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      color:var(--text);
      text-decoration:none; font-weight:700;
      transition: transform .08s ease, background .15s ease, border-color .15s ease;
      white-space:nowrap;
    }
    .btn:hover{ transform: translateY(-1px); background: rgba(255,255,255,.10); border-color: rgba(255,255,255,.22); }
    .btn-primary{
      background: linear-gradient(135deg, rgba(79,140,255,.95), rgba(79,140,255,.70));
      border-color: rgba(79,140,255,.65);
      box-shadow: 0 14px 36px rgba(79,140,255,.20);
    }
    .btn-primary:hover{ background: linear-gradient(135deg, rgba(79,140,255,1), rgba(79,140,255,.78)); }
    .btn-success{
      background: linear-gradient(135deg, rgba(52,211,153,.92), rgba(52,211,153,.62));
      border-color: rgba(52,211,153,.55);
      box-shadow: 0 14px 36px rgba(52,211,153,.18);
      color:#071216;
    }
    .btn-success:hover{ background: linear-gradient(135deg, rgba(52,211,153,1), rgba(52,211,153,.70)); }
    .pill{
      display:inline-flex; gap:8px; align-items:center;
      padding:8px 10px;
      border:1px solid rgba(255,255,255,.14);
      border-radius: 999px;
      background: rgba(255,255,255,.06);
      color: var(--muted);
      font-size:13px;
    }
    .hero{
      padding:54px 0 26px;
    }
    .hero-grid{
      display:grid;
      grid-template-columns: 1.2fr .8fr;
      gap:18px;
      align-items:stretch;
    }
    .hero h1{
      margin:14px 0 10px;
      font-size: clamp(28px, 4.1vw, 44px);
      line-height:1.08;
      letter-spacing:-.6px;
    }
    .lead{
      color: var(--muted);
      font-size: 16px;
      max-width: 62ch;
    }
    .hero-actions{ display:flex; gap:12px; flex-wrap:wrap; margin-top:18px; }
    .microproof{
      margin-top:16px;
      display:flex; gap:10px; flex-wrap:wrap;
      color: var(--muted);
      font-size:13px;
    }
    .microproof span{
      border:1px dashed rgba(255,255,255,.18);
      padding:8px 10px;
      border-radius: 14px;
      background: rgba(255,255,255,.04);
    }
    .panel{
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border: 1px solid rgba(255,255,255,.12);
      border-radius: var(--radius2);
      box-shadow: var(--shadow);
      padding:18px;
    }
    .panel h3{ margin:0 0 10px; font-size:16px; }
    .form{
      display:grid;
      gap:10px;
      margin-top:8px;
    }
    .field{
      display:grid;
      gap:6px;
    }
    label{ font-size:12px; color: var(--muted); }
    input, textarea, select{
      width:100%;
      padding:12px 12px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(15,26,51,.55);
      color: var(--text);
      outline:none;
    }
    input:focus, textarea:focus{
      border-color: rgba(79,140,255,.55);
      box-shadow: 0 0 0 4px rgba(79,140,255,.16);
    }
    textarea{ min-height: 92px; resize: vertical; }
    .hint{ font-size:12px; color: var(--muted); }

    section{ padding:26px 0; }
    .section-title{
      display:flex; align-items:flex-end; justify-content:space-between;
      gap:12px; flex-wrap:wrap;
      margin-bottom:12px;
    }
    .section-title h2{
      margin:0;
      font-size: 22px;
      letter-spacing:-.2px;
    }
    .section-title p{
      margin:0;
      color: var(--muted);
      max-width: 70ch;
      font-size: 14px;
    }

    .grid-3{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:12px;
    }
    .grid-2{
      display:grid;
      grid-template-columns: repeat(2, 1fr);
      gap:12px;
    }
    .card{
      background: rgba(16,28,58,.62);
      border:1px solid rgba(255,255,255,.12);
      border-radius: var(--radius);
      padding:16px;
    }
    .card h4{ margin:0 0 6px; font-size:15px; }
    .card p{ margin:0; color: var(--muted); font-size: 14px; }

    ul.check{
      margin: 0;
      padding: 0;
      list-style: none;
      display:grid;
      gap:10px;
    }
    ul.check li{
      display:flex; gap:10px; align-items:flex-start;
      color: var(--text);
    }
    .tick{
      width:18px; height:18px; margin-top:2px;
      border-radius: 6px;
      background: rgba(52,211,153,.20);
      border:1px solid rgba(52,211,153,.35);
      position:relative;
      flex:0 0 auto;
    }
    .tick:after{
      content:"";
      position:absolute;
      left:5px; top:3px;
      width:6px; height:9px;
      border-right:2px solid rgba(52,211,153,1);
      border-bottom:2px solid rgba(52,211,153,1);
      transform: rotate(40deg);
    }
    .muted{ color: var(--muted); }
    .kpis{
      display:flex; gap:10px; flex-wrap:wrap;
      margin-top:12px;
    }
    .kpi{
      padding:10px 12px;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.04);
      font-size: 13px;
      color: var(--muted);
    }
    .kpi b{ color: var(--text); }

    .packages .card{ position:relative; overflow:hidden; }
    .badge{
      position:absolute; top:12px; right:12px;
      font-size:12px;
      padding:6px 10px;
      border-radius: 999px;
      border:1px solid rgba(255,255,255,.14);
      background: rgba(255,255,255,.06);
      color: var(--muted);
    }

    .timeline{
      display:grid; gap:10px;
    }
    .step{
      display:flex; gap:12px; align-items:flex-start;
      padding:14px;
      border-radius: var(--radius);
      border:1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.04);
    }
    .num{
      width:30px; height:30px;
      border-radius: 12px;
      display:grid; place-items:center;
      background: rgba(79,140,255,.18);
      border:1px solid rgba(79,140,255,.35);
      color: var(--text);
      font-weight:800;
      flex:0 0 auto;
    }

    .gallery{
      display:grid;
      grid-template-columns: repeat(6, 1fr);
      gap:10px;
    }
    .ph{
      border-radius: 16px;
      border:1px solid rgba(255,255,255,.12);
      background:
        linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.02)),
        radial-gradient(500px 180px at 10% 10%, rgba(79,140,255,.22), transparent 60%),
        rgba(255,255,255,.04);
      height: 108px;
      position:relative;
      overflow:hidden;
    }
    .ph:after{
      content:"Dodajte realnu fotografiju";
      position:absolute; left:12px; bottom:10px;
      font-size:12px; color: rgba(234,240,255,.75);
    }

    .faq{
      display:grid; gap:10px;
    }
    details{
      border:1px solid rgba(255,255,255,.12);
      border-radius: var(--radius);
      background: rgba(255,255,255,.04);
      padding: 12px 14px;
    }
    summary{
      cursor:pointer;
      font-weight:700;
      list-style:none;
    }
    summary::-webkit-details-marker{ display:none; }
    details p{ color: var(--muted); margin:10px 0 0; }

    .cta{
      background: linear-gradient(135deg, rgba(79,140,255,.18), rgba(52,211,153,.12));
      border:1px solid rgba(255,255,255,.12);
      border-radius: var(--radius2);
      padding: 18px;
      display:flex;
      gap:14px;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
    }

    footer{
      padding: 22px 0 80px;
      color: var(--muted);
      font-size: 13px;
      border-top:1px solid rgba(255,255,255,.10);
      margin-top: 20px;
    }

    /* Mobile sticky call bar */
    .sticky-call{
      position:fixed;
      left:0; right:0; bottom:0;
      padding:10px 12px;
      background: rgba(11,18,32,.82);
      border-top:1px solid rgba(255,255,255,.12);
      backdrop-filter: blur(12px);
      display:none;
      z-index:60;
    }
    .sticky-call .inner{
      max-width: var(--max);
      margin: 0 auto;
      display:flex;
      gap:10px;
    }
    .sticky-call .btn{ flex:1; }

    /* Responsive */
    @media (max-width: 980px){
      .hero-grid{ grid-template-columns: 1fr; }
      .grid-3{ grid-template-columns: 1fr; }
      .grid-2{ grid-template-columns: 1fr; }
      .gallery{ grid-template-columns: repeat(3, 1fr); }
      .nav{ display:none; }
      .sticky-call{ display:block; }
    }
    @media (max-width: 420px){
      .gallery{ grid-template-columns: repeat(2, 1fr); }
    }
  </style>

  <!-- FAQ Schema (edit phone/email/location placeholders) -->
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"FAQPage",
